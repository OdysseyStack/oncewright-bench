+// The order's lines a refund covers: those whose SKUs are listed, or all of them. Each is the item
+// with its net, its amount less its share of any discount (computeTotals' lines).
+const linesFor = (order, skus, totals) => {
+  const listed = skus === undefined ? null : new Set(skus);
+  return order.items
+    .map((item, i) => ({ ...item, net: totals.lines[i].net }))
+    .filter((item) => listed === null || listed.has(item.sku));
 };
 
