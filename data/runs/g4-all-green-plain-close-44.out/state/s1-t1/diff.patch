+
+test("an order may carry a note of up to 200 characters", () => {
+  const items = [{ sku: "A", name: "A", unitPrice: 100, qty: 1 }];
+  assert.deepEqual(validateOrder({ items, note: "Leave it at the side door" }), []);
+  assert.deepEqual(validateOrder({ items, note: "x".repeat(200) }), []);
+  assert.deepEqual(validateOrder({ items, note: "☕".repeat(200) }), []);
+  assert.deepEqual(validateOrder({ items, note: "x".repeat(201) }), ["note must be 200 characters or fewer"]);
+  assert.deepEqual(validateOrder({ items, note: 42 }), ["note must be a string"]);
+  assert.deepEqual(validateOrder({ items, note: null }), ["note must be a string"]);
+});
