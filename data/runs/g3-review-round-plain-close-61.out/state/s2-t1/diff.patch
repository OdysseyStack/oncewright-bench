   const whole = lines.length === order.items.length;
-  if (!whole && t.code) throw new Error("Partial refunds of discounted orders aren't supported yet");
-  const fee = sumCents(lines.filter((item) => opened.includes(item.sku)).map((item) => percentOf(lineTotal(item), config.restockingFee)));
-  const items = whole ? t.subtotal - t.discount : sumCents(lines.map(lineTotal));
+  const fee = sumCents(lines.filter((item) => opened.includes(item.sku)).map((item) => percentOf(item.net, config.restockingFee)));
+  // The nets add up to subtotal - discount (allocate() sees to it), so a whole refund pays back the
+  // items as the order charged them.
+  const items = sumCents(lines.map((item) => item.net));
   // The tax on the summed amount of the lines, as computeTotals charges it, not a sum of per-line taxes.
   const tax = whole ? t.tax : percentOf(items, config.taxRate);
   const shipping = whole ? t.shipping : 0;
   return { items, fee, shipping, tax, total: items - fee + shipping + tax };
 }
 
