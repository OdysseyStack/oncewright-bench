+// The order's lines a refund covers, each with its net from computeTotals (its amount less its
+// share of any discount): those whose SKUs are listed, or all of them.
+const linesFor = (order, skus, totals) => {
+  const wanted = skus === undefined ? null : new Set(skus);
+  return order.items
+    .map((item, i) => ({ ...item, net: totals.lines[i].net }))
+    .filter((item) => wanted === null || wanted.has(item.sku));
 };
 
 // What a refund pays back, in cents: { items, fee, shipping, tax, total }. options: the options the
 // order was priced with (pickup, code), plus skus, the lines to refund (all of them when absent),
-// and opened, the refunded lines that keep a restocking fee.
+// and opened, the refunded lines that keep a restocking fee. Each line pays back its net, the
+// amount it was charged after its share of any discount, and the fee is taken on that net.
 export function refundFor(order, options = {}) {
   const t = computeTotals(order, options);
   const { skus, opened = [] } = options;
   const unknown = [...(skus ?? []), ...opened].find((sku) => !order.items.some((item) => item.sku === sku));
   if (unknown !== undefined) throw new Error(`SKU not on the order: ${unknown}`);
-  const lines = linesFor(order, skus);
