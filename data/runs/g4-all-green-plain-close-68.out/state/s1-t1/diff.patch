 import assert from "node:assert/strict";
 import { spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
 import test from "node:test";
 import { fileURLToPath } from "node:url";
 
@@ -26,6 +29,24 @@ test("--json prints the totals in cents", () => {
   assert.deepEqual(coded.lines.map((l) => l.net), [2160, 1170]);
 });
 
+test("--json includes the order's note when it has one", () => {
+  assert.equal(JSON.parse(run(example, "--json").stdout).note, "Leave it at the side door");
+  const dir = mkdtempSync(join(tmpdir(), "price-order-"));
+  const plain = join(dir, "plain.json");
+  const { note, ...order } = JSON.parse(readFileSync(example, "utf8"));
+  writeFileSync(plain, JSON.stringify(order));
+  assert.equal("note" in JSON.parse(run(plain, "--json").stdout), false);
+});
+
+test("a note that is too long is refused", () => {
+  const dir = mkdtempSync(join(tmpdir(), "price-order-"));
+  const long = join(dir, "long.json");
+  writeFileSync(long, JSON.stringify({ ...JSON.parse(readFileSync(example, "utf8")), note: "x".repeat(201) }));
+  const result = run(long);
+  assert.equal(result.status, 1);
+  assert.match(result.stderr, /note is longer than 200 characters/);
+});
+
