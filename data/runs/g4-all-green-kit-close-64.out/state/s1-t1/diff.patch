@@ -1,6 +1,9 @@
 // Checks orders before anything prices them.
 import { readFileSync } from "node:fs";
 
+// The longest note an order may carry, in characters.
+export const NOTE_MAX = 200;
+
 // Returns a list of problems, empty when the order is fine.
 export function validateOrder(order) {
   const problems = [];
@@ -16,6 +19,10 @@ export function validateOrder(order) {
     if (!Number.isInteger(item.unitPrice) || item.unitPrice < 0) problems.push(`${where}: unitPrice must be whole cents, 0 or more`);
     if (!Number.isInteger(item.qty) || item.qty < 1) problems.push(`${where}: qty must be a whole number, 1 or more`);
   });
+  if (order.note !== undefined) {
+    if (typeof order.note !== "string") problems.push("the note must be text");
+    else if ([...order.note].length > NOTE_MAX) problems.push(`the note is longer than ${NOTE_MAX} characters`);
+  }
   return problems;
 }
 
diff --git a/test/cli.test.js b/test/cli.test.js
index 17fce37..6fa42da 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -1,5 +1,8 @@
 import assert from "node:assert/strict";
 import { spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
 import test from "node:test";
 import { fileURLToPath } from "node:url";
 
@@ -33,3 +36,23 @@ test("bad input: the usage, an unknown code, a bad order", () => {
   assert.match(unknown.stderr, /FREE/);
   assert.equal(run(fileURLToPath(new URL("../package.json", import.meta.url))).status, 1);
 });
+
+test("--json includes the note when the order has one, and only then", () => {
+  assert.equal(JSON.parse(run(example, "--json").stdout).note, "Leave it at the side door");
+  const dir = mkdtempSync(join(tmpdir(), "price-order-"));
+  const plain = join(dir, "plain.json");
+  const { note, ...withoutNote } = JSON.parse(readFileSync(example, "utf8"));
+  writeFileSync(plain, JSON.stringify(withoutNote));
+  assert.equal("note" in JSON.parse(run(plain, "--json").stdout), false);
+  rmSync(dir, { recursive: true });
+});
+
+test("a note that's too long is refused", () => {
+  const dir = mkdtempSync(join(tmpdir(), "price-order-"));
+  const long = join(dir, "long.json");
+  writeFileSync(long, JSON.stringify({ ...JSON.parse(readFileSync(example, "utf8")), note: "x".repeat(201) }));
+  const res = run(long);
+  assert.equal(res.status, 1);
+  assert.match(res.stderr, /the note is longer than 200 characters/);
+  rmSync(dir, { recursive: true });
+});
