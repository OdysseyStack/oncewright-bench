+  const fee = sumCents(lines.filter(({ item }) => opened.includes(item.sku)).map(({ net }) => percentOf(net, config.restockingFee)));
+  const items = sumCents(lines.map(({ net }) => net));
+  // Tax on the lines' summed amount, as computeTotals charges it, not summed per line. For a whole
