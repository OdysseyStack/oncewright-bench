diff --git a/test/receipt.test.js b/test/receipt.test.js
index 427d3e8..a453b5c 100644
--- a/test/receipt.test.js
+++ b/test/receipt.test.js
@@ -40,3 +40,18 @@ test("with a code, each line shows its price after the discount", () => {
     ].join("\n"),
   );
 });
+
+test("a note is the last line, after a blank line", () => {
+  const noted = { ...order, note: "Leave it at the side door" };
+  assert.equal(renderReceipt(noted), `${renderReceipt(order)}\n\nNote: Leave it at the side door`);
+  assert.equal(
+    renderReceipt(noted, { code: "SAVE10" }),
+    `${renderReceipt(order, { code: "SAVE10" })}\n\nNote: Leave it at the side door`,
+  );
+  assert.ok(renderReceipt(noted, { code: "SAVE10" }).endsWith("Code SAVE10 saved you $3.70\n\nNote: Leave it at the side door"));
+});
+
+test("without a note the receipt doesn't change", () => {
+  assert.ok(!renderReceipt(order).includes("Note:"));
+  assert.equal(renderReceipt({ ...order, note: "" }), renderReceipt(order));
+});
