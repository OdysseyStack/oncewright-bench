+test("a note is optional text of up to 200 characters", () => {
+  const items = [{ sku: "A", name: "A", unitPrice: 100, qty: 1 }];
+  assert.deepEqual(validateOrder({ items, note: "Ring twice" }), []);
+  assert.deepEqual(validateOrder({ items, note: "x".repeat(200) }), []);
+  assert.deepEqual(validateOrder({ items, note: "☕".repeat(200) }), []);
+  assert.deepEqual(validateOrder({ items, note: "x".repeat(201) }), ["note is longer than 200 characters"]);
