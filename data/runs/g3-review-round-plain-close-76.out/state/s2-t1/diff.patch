+// The order's lines a refund covers, those whose SKUs are listed or all of them, each with its net:
+// its amount less its share of any discount, from computeTotals.
+function linesFor(order, skus, totals) {
+  const wanted = skus === undefined ? null : new Set(skus);
+  return order.items
+    .map((item, i) => ({ ...item, net: totals.lines[i].net }))
+    .filter((item) => wanted === null || wanted.has(item.sku));
 }
 
